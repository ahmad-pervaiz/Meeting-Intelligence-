# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
BASE_URL=http://localhost:8000

# AI Model Configuration (CPU Only, 16GB RAM)
WHISPER_MODEL_NAME=large-v3-turbo
DEVICE=cpu
COMPUTE_TYPE=int8
CPU_THREADS=4
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Hugging Face Token (Optional for pyannote diarization; automatic energy/VAD fallback if unset)
HF_TOKEN=

# Cloud LLM Free Tiers (Groq Free Tier or Google Gemini Free Tier)
# Provide at least one for cloud synthesis; if unset, system uses local extractive fallback
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
# Groq: llama-3.3-70b-versatile | Gemini: gemini-2.5-flash or gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Email Dispatcher Configuration
# Option 1: Resend (Free 3,000 emails/mo)
RESEND_API_KEY=
EMAIL_FROM=Meeting Intelligence <onboarding@resend.dev>

# Option 2: Gmail SMTP Fallback
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Database & Storage
# Uses local SQLite and ChromaDB by default (100% zero configuration)
DATABASE_URL=sqlite:///./meeting_intelligence.db
STORAGE_DIR=./uploads
PDF_STORAGE_DIR=./generated_pdfs
